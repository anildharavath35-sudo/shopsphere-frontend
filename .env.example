# Public Razorpay Key ID - safe to expose to the browser.
# It is loaded at runtime to initialise the Razorpay checkout widget.
# Leave blank while using PAYMENT_DEV_MODE=true on the server.
VITE_RAZORPAY_KEY_ID=

# Backend API base URL.
# In local dev leave unset - Vite proxies /api to http://localhost:5000.
# On Vercel, set this to your Render backend, e.g. https://your-app.onrender.com (no trailing slash).
VITE_API_URL=https://your-app.onrender.com